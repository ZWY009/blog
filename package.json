{
  "name": "blog",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "pnpm build && vite preview --port 5173",
    "dev": "pnpm start",
    "build": "vite build && tsx scripts/build-blog.ts",
    "content": "tsx scripts/build-blog.ts",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "size": "size-limit",
    "gates": "node ../../gates/run-gates.mjs --root ."
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@size-limit/file": "^14.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "gray-matter": "^4.0.3",
    "jsdom": "^30.1.3",
    "marked": "^18.1.2",
    "prettier": "^3.9.10",
    "shiki": "^4.5.0",
    "size-limit": "^14.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
